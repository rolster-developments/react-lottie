{
  "name": "@rolster/react-lottie",
  "version": "19.3.2",
  "type": "module",
  "description": "Package containing UI components for Lottie in React.",
  "license": "MIT",
  "author": "Rolster Technology <rolster.developments@gmail.com>",
  "contributors": [
    {
      "name": "Daniel Andrés Castillo Pedroza",
      "email": "ing.dacastillop@gmail.com"
    }
  ],
  "types": "./dist/esm/index.d.ts",
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/es/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "node": {
        "require": "./dist/cjs/index.cjs",
        "import": "./dist/es/index.mjs"
      },
      "default": "./dist/es/index.mjs"
    }
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "prettier": "prettier --write .",
    "prettier:css": "prettier --write dist/**/*.css --ignore-path .prettierignore",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "clean": "rimraf ./dist",
    "dev": "vite",
    "build:css": "sass src/:dist/esm/ --style=compressed",
    "build": "npm run clean && tsc -p tsconfig.app.json && rolster-rollup",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "lottie-web": "^5.10.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rolster/rollup": "^2.2.0",
    "@rolster/types": "^1.1.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.2.1",
    "eslint": "^10.7.0",
    "eslint-plugin-perfectionist": "^5.10.0",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "jsdom": "^27.0.0",
    "prettier": "^3.8.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "rimraf": "^6.1.3",
    "tslib": "^2.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^6.4.1",
    "vitest": "^5.0.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rolster-developments/react-lottie.git"
  },
  "keywords": [
    "lottie",
    "react",
    "lottie react",
    "react lottie",
    "lottie web",
    "animation",
    "component"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  }
}
