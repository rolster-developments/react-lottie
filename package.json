{
  "name": "@rolster/react-lottie",
  "version": "19.2.0",
  "type": "module",
  "description": "Package containing UI components for Lottie in React.",
  "license": "MIT",
  "author": "Rolster Technology <rolster.developments@gmail.com>",
  "contributors": [
    {
      "name": "Daniel Andrés Castillo Pedroza",
      "email": "ing.dacastillop@gmail.com"
    }
  ],
  "types": "./dist/esm/index.d.ts",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "node": {
        "require": "./dist/cjs/index.js",
        "import": "./dist/esm/index.js"
      },
      "default": "./dist/esm/index.js"
    }
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "prettier": "prettier --write \"src/**/*.{ts}\"",
    "prettier:css": "prettier --write dist/**/*.css --ignore-path .prettierignore",
    "clean": "rimraf ./dist",
    "dev": "vite",
    "build:css": "sass src/:dist/esm/ --style=compressed",
    "build": "npm run clean && tsc -p tsconfig.app.json && rollup -c rollup.config.mjs",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "lottie-web": "^5.10.2"
  },
  "devDependencies": {
    "@babel/core": "^7.16.7",
    "@babel/preset-env": "^7.16.8",
    "@babel/preset-react": "^7.16.7",
    "@babel/plugin-proposal-decorators": "^7.21.0",
    "@rolster/rollup": "^1.1.0",
    "@rolster/styles-foundations": "^2.6.16",
    "@rolster/types": "^1.1.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^5.57.1",
    "@typescript-eslint/parser": "^5.57.1",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/ui": "^3.2.4",
    "eslint": "^8.38.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.3.4",
    "match-sorter": "^6.3.1",
    "object-path": "^0.11.8",
    "prettier": "^3.8.1",
    "rimraf": "^3.0.2",
    "sort-by": "^0.0.2",
    "typescript": "^5.7.2",
    "vite": "^6.4.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rolster-developments/react-lottie.git"
  },
  "keywords": [
    "lottie",
    "react",
    "lottie react",
    "react lottie",
    "lottie web",
    "animation",
    "component"
  ],
  "publishConfig": {
    "access": "public"
  }
}

